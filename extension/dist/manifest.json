{
  "manifest_version": 3,
  "name": "Job Application Tracker Saver",
  "version": "1.0.0",
  "description": "Save the job posting you're viewing straight into your Job Application Tracker.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save this job"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
